{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {},
    },
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny",
    },
    "context_edit": {
      "*": "allow",
    },
    "context_deref": {
      "*": "allow",
    },
    "context_history": {
      "*": "allow",
    },
    "thread_park": {
      "*": "allow",
    },
    "thread_list": {
      "*": "allow",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
